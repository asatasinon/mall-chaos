# Castrel Chaos — 环境变量模板
# 复制为 .env 并按需修改：cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=castrel
MYSQL_USER=castrel
MYSQL_PASSWORD=castrel

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Observability ───────────────────────────────────────────────────────────
# Tracing 由 OTel Java agent 负责（Micrometer bridge 已禁用），只需配置 OTLP 上报地址。
# 本地启用可观测栈（--profile observability）时保持默认值即可。
#
# 接入 Grafana Cloud 时改为：
#   OTLP_ENDPOINT=https://<your-instance>.grafana.net/otlp
OTLP_ENDPOINT=http://tempo:4318
