# Castrel Chaos — 环境变量模板
# 复制为 .env 并按需修改：cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=castrel
MYSQL_USER=castrel
MYSQL_PASSWORD=castrel

# Required shared authentication secrets. Replace before deployment.
CASTREL_JWT_SECRET=JgbOGI7oh4NnAwkla4czT9SwCh5QlqiqUSptGAByu1mWpVA7RoYR8f38w0j1tfVI
CASTREL_INTERNAL_SERVICE_KEY=KgbOGI7oh4NnAwkla4czT9SwCh5QlqiqUSptGAByu1mWpVA7RoYR8f38w0j1tfVI
TRAFFIC_RUNNER_CREDENTIAL=
# Lifecycle login is disabled by default. When enabled, inject this JSON from a deployment Secret.
TRAFFIC_LIFECYCLE_LOGIN_ENABLED=false
TRAFFIC_LIFECYCLE_ACCOUNTS=[]
# Control plane login defaults (override before deployment).
CONTROL_PLANE_USERNAME=castrel
CONTROL_PLANE_PASSWORD=C@stre1_best_ai
CONTROL_PLANE_SESSION_SECRET=LgbOGI7oh4NnAwkla4czT9SwCh5QlqiqUSptGAByu1mWpVA7RoYR8f38w0j1tfVI
# Set true when the control plane is served over HTTPS.
CONTROL_PLANE_COOKIE_SECURE=false
OPERATOR_ID=3

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Additional Grafana user provisioned automatically on first startup via grafana-init
GRAFANA_CASTREL_USER=castrel
GRAFANA_CASTREL_PASSWORD=C@stre1_best_ai

# ─── Observability ───────────────────────────────────────────────────────────
# Tracing 由 OTel Java agent 负责（Micrometer bridge 已禁用），只需配置 OTLP 上报地址。
# 可观测栈默认随 docker-compose up -d 启动，保持默认值即可。
#
# 接入 Grafana Cloud 时改为：
#   OTLP_ENDPOINT=https://<your-instance>.grafana.net/otlp
OTLP_ENDPOINT=http://tempo:4318

# ─── Spring Runtime Overrides (optional) ────────────────────────────────────
# application.yml 已提供本地默认值；以下变量主要供 Docker Compose 或 CI 覆盖。
SPRING_DATA_REDIS_PORT=16379

# Optional service URL overrides used by gateway/order/traffic-runner.
ORDER_SERVICE_URL=http://order-service:8084
CATALOG_SERVICE_URL=http://catalog-service:8082
USER_SERVICE_URL=http://user-service:8081
INVENTORY_SERVICE_URL=http://inventory-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8085
